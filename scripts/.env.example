# テンプレート（このファイルを .env にコピーして編集）

# ----- 必須 -----
RESERVATION_USER_ID=your_user_id
RESERVATION_PASSWORD=your_password
LINE_CHANNEL_ID=your_channel_id
LINE_CHANNEL_SECRET=your_channel_secret
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- 施設・期間・時間帯の指定（任意） -----
# 施設名（複数指定する場合はカンマ区切り）。通知文の「〇〇体育館の○月○日の夜間枠に空きが出ました」の〇〇部分
# 1つ: FACILITY_NAME=西体育館
# 複数: FACILITY_NAMES=西体育館,東体育館,南体育館
FACILITY_NAME=西体育館

# 検索で絞り込む施設名の一部。未指定時は上記の施設名を使用
# FACILITY_NAME_PART=西体育館

# チェックしたい日（1日だけ指定する場合）
# CHECK_DATE=2026-03-15

# 期間を指定する場合（CHECK_DATE から CHECK_DATE_END まで）。未指定なら「実行日から3ヶ月後まで」が対象
# CHECK_DATE=2026-03-15
# CHECK_DATE_END=2026-03-22

# 時間帯の表示名（通知の「夜間枠」部分。例: 夜間枠 / 午前の部）
TIME_SLOT_LABEL=夜間枠

# 利用目的（省略時: バドミントン）
# PURPOSE_LABEL=バドミントン

# デバッグ: カレンダーページの内容を scripts/debug-calendar-period-*.txt に保存
# DEBUG_CALENDAR=1

# ----- 上記の代わりに Channel access token を直接使う場合 -----
# LINE_CHANNEL_ACCESS_TOKEN=xxxx
